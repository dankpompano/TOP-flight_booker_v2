<%= form_with model: @booking do |form| %>
  <table>
      <thead>
        <tr>Flights</tr><br><br>
      </thead>

        <tbody>
          <tr> <%=form.label :start, "Date" %> </tr><br>
          <tr> <%=form.time_select :start %> </tr><br>

          <tr> <%=form.label :arrival, "Arriving Airport" %> </tr><br>
          <tr> <%=form.collection_select :arrival_airport_id, Airport.all, :id, :code, prompt: 'Select an Airport' %> </tr><br>

          <%= form.fields_for :passengers do |passenger_fields| %>
            <div>
              <tr><%= passenger_fields.label :name %></tr><br>
              <tr><%= passenger_fields.text_field :name %></tr><br>
              <tr><%= passenger_fields.label :email %></tr><br>
              <tr><%= passenger_fields.text_field :email %></tr><br>
            </div>
          <% end %>
        </tbody>
      <%= form.submit "Submit" %>
  </table>
<% end %>
